# --- LLM ---------------------------------------------------------------
# OpenAI API key (also accepted by Vercel AI Gateway when running on Vercel).
OPENAI_API_KEY=sk-your-openai-key-here

# Chat model. Cheap default; override freely.
OPENAI_CHAT_MODEL=gpt-4o-mini

# Embeddings model. -small is 5x cheaper than -large with strong quality.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Vector store (Qdrant) --------------------------------------------
# Local docker default: http://localhost:6333
# Qdrant Cloud: https://<cluster-id>.<region>.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333

# Required only for Qdrant Cloud
QDRANT_API_KEY=

# Collection name in Qdrant. Created automatically on first ingest.
QDRANT_COLLECTION=notebooklm_rag

# --- Retrieval tuning -------------------------------------------------
# How many chunks to retrieve per query
RAG_TOP_K=5

# Chunking parameters (characters)
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
